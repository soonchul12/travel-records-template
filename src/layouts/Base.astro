---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  expect?: string;
}
const { title, description, image, expect } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="head-start" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..700&family=JetBrains+Mono:wght@400;500&family=Nanum+Pen+Script&family=Noto+Serif+KR:wght@400;600;900&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    {expect && <link rel="expect" href={expect} blocking="render" />}
    <script is:inline>
      // 목록 ↔ 여행 페이지 전환: 누른 여행의 표지와 여행 페이지 첫 화면에 같은 이름을 붙여 표지가 화면 전체로 커지게 한다.
      // pagereveal 은 첫 렌더 전에 오므로 head 의 일반 스크립트에서 등록해야 한다.
      (() => {
        const NAME = 'trip-cover';
        const slugOf = (url) => {
          try { return new URL(url, location.href).pathname.match(/^\/trips\/([^/]+)\/?$/)?.[1]; } catch { return undefined; }
        };
        const isHome = (url) => { try { return new URL(url, location.href).pathname === '/'; } catch { return false; } };
        const cover = (slug) => slug && document.querySelector(`[data-vt-cover="${CSS.escape(slug)}"] .cover-img`);
        const hero = () => document.querySelector('[data-vt-hero]');
        const tag = (el, vt) => {
          if (!el) return;
          el.style.viewTransitionName = NAME;
          const clear = () => (el.style.viewTransitionName = '');
          vt.finished.then(clear, clear);
        };
        let clicked;
        addEventListener('click', (e) => {
          const a = e.target instanceof Element && e.target.closest('a[href]');
          if (a) clicked = a.href;
        }, true);
        addEventListener('pageswap', (e) => {
          if (!e.viewTransition) return;
          e.viewTransition.ready.catch(() => {});
          e.viewTransition.finished.catch(() => {});
          const to = e.activation?.entry?.url ?? clicked;
          if (isHome(location.href)) tag(cover(slugOf(to)), e.viewTransition);
          else if (slugOf(location.href) && isHome(to)) tag(hero(), e.viewTransition);
        });
        addEventListener('pagereveal', (e) => {
          if (!e.viewTransition) return;
          e.viewTransition.ready.catch(() => {});
          e.viewTransition.finished.catch(() => {});
          const from = window.navigation?.activation?.from?.url ?? document.referrer;
          if (slugOf(location.href) && isHome(from)) tag(hero(), e.viewTransition);
          else if (isHome(location.href)) tag(cover(slugOf(from)), e.viewTransition);
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
